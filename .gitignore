# 编译产物
*.exe
*.exe~
*.dll
*.so
*.dylib

# 二进制文件
/go-http-service
/server

# 测试二进制文件
*.test

# 覆盖率文件
*.out
coverage.html

# Go workspace file
go.work
go.work.sum

# Go 构建缓存（本机 ~/.cache/go-build 有权限问题时会指向这里）
.go-cache/

# IDE
.idea/
.vscode/

# Local secrets for compose. Keep .env.example in git.
.env
.env.local

# One-way local copies of Posts (pull-blog-posts). Server is the source of truth.
# Keep the pull script tracked; ignore the Markdown copies.
notes/blog/*.md

# OS generated files
.DS_Store
Thumbs.db
