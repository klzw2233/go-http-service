<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.SiteName}}</title>
<script>try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
<link rel="stylesheet" href="/site.css">
</head>
<body>
<h1>{{.SiteName}}</h1>
{{if .Posts}}
<ul class="post-list">
{{range .Posts}}
<li><a href="/posts/{{.Slug}}">{{.Title}}</a> <time datetime="{{.PublishedAt.UTC.Format "2006-01-02T15:04:05Z"}}">{{.PublishedAt.UTC.Format "2006-01-02"}}</time></li>
{{end}}
</ul>
{{else}}
<p>No posts yet.</p>
{{end}}
<footer>
<a href="/author/posts">Author</a>
<button type="button" id="theme-toggle">Theme</button>
</footer>
<script src="/theme.js"></script>
</body>
</html>
