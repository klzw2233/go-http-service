<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{if eq .Mode "new"}}New post{{else}}Edit{{end}} · {{.SiteName}}</title>
</head>
<body data-mode="{{.Mode}}">
<h1>{{if eq .Mode "new"}}New post{{else}}Edit{{end}}</h1>
<p><a href="/author/posts">All posts</a> · <button type="button" id="logout">Sign out</button></p>
<form id="edit-form">
<label>Title <input id="title" name="title" required></label>
<label>Slug <input id="slug" name="slug" {{if eq .Mode "edit"}}readonly{{end}} required></label>
<label>Body <textarea id="body" name="body" rows="16" required></textarea></label>
<button type="submit">Save</button>
<button type="button" id="preview-btn">Preview</button>
<button type="button" id="publish-btn">Publish</button>
<button type="button" id="unpublish-btn">Unpublish</button>
</form>
<div id="preview"></div>
<p id="error" hidden></p>
<p><a href="/">{{.SiteName}}</a></p>
<script src="/author/app.js"></script>
</body>
</html>
