<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Posts · {{.SiteName}}</title>
<script>try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
<link rel="stylesheet" href="/site.css">
</head>
<body>
<h1>Posts</h1>
<p class="actions"><a href="/author/new">New post</a> <button type="button" id="logout">Sign out</button></p>
<table>
<thead><tr><th>Title</th><th>Slug</th><th>State</th></tr></thead>
<tbody id="rows"></tbody>
</table>
<p id="error" hidden></p>
<footer>
<a href="/">{{.SiteName}}</a>
<button type="button" id="theme-toggle">Theme</button>
</footer>
<script src="/theme.js"></script>
<script src="/author/app.js"></script>
</body>
</html>
