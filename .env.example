# Copy to ".env" in this directory. Docker Compose reads ".env" automatically
# for ${VAR} interpolation. Do not commit ".env".
#
#   cp .env.example .env
#   docker compose up -d --wait
#
# JWT_SECRET signs access tokens (HS256). Required, at least 32 bytes.
# Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-bytes-long!!

# AUTHOR_USERNAME names the User who may write Posts. Required.
# Compared case-insensitively with users.username.
AUTHOR_USERNAME=jimmy

# DEV_AUTHOR_PASSWORD is optional. When set, the first process start inserts
# AUTHOR_USERNAME into users (bcrypt) if that username is missing. An existing
# account is never overwritten. Leave empty in production.
# Login at /author/login with AUTHOR_USERNAME and this password.
DEV_AUTHOR_PASSWORD=correct-horse
